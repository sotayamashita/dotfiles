{
  // Telemetry settings
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },

  // Agent servers configuration (MCP servers)
  "agent_servers": {
    "codex-acp": {
      "type": "registry",
    },
    "claude-acp": {
      "type": "registry",
    },
  },

  // Open folders in a new window
  "cli_default_open_behavior": "new_window",

  // Use macOS native window tabs
  "use_system_window_tabs": true,

  // Show whitespace characters: all, selection, none, boundary
  "show_whitespaces": "all",

  // UI font family (for menus, panels, etc.)
  "ui_font_family": "iA Writer Quattro V",

  // UI font size (for menus, panels, etc.)
  "ui_font_size": 17.0,

  // Editor buffer font size
  "buffer_font_size": 18.5,

  // Only show error on tab
  "tabs": {
    "file_icons": true,
    "git_status": true,
    "show_diagnostics": "errors",
  },

  // Indentation guides (rainbow indentation)
  "indent_guides": {
    "enabled": true,
    "coloring": "indent_aware",
  },

  // File scan exclusions (files to hide from file explorer and search)
  "file_scan_exclusions": [
    // Inherit Zed's default exclusions
    "...",
    // Custom exclusions
    "**/out",
    "**/dist",
    "**/.turbo",
    "**/.vscode",
    "**/.next",
    "**/.storybook",
    "**/node_modules",
  ],

  // Project panel settings
  "project_panel": {
    "hide_root": true,
    "dock": "left"
  },
}
