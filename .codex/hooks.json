{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "~/.codex/hooks/sfw-post-edit.sh",
            "statusMessage": "Checking dependency manifest edits",
            "type": "command"
          }
        ],
        "matcher": "Edit|Write"
      },
      {
        "matcher": ".*[Ww]ait.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.agents/skills/implementation-orchestrator/scripts/runtime_attestation.py --wait-hook",
            "statusMessage": "Attesting completed subagents"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "~/.codex/hooks/sfw-gate.sh",
            "statusMessage": "Checking Bash command",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bash '~/.codex/herdr-agent-state.sh' session",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "tldraw-offline",
        "hooks": [
          {
            "type": "command",
            "command": "sh '~/skills/tldraw-offline/inject-server-context.sh' SubagentStart"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "^implementation_orchestrator_.*$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.agents/skills/implementation-orchestrator/scripts/runtime_attestation.py --hook",
            "statusMessage": "Attesting subagent runtime"
          }
        ]
      }
    ]
  }
}
