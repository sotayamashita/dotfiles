{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "\"$HOME/.codex/hooks/sfw-gate.sh\"",
            "statusMessage": "Checking Bash command",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "\"$HOME/.codex/hooks/sfw-post-edit.sh\"",
            "statusMessage": "Checking dependency manifest edits",
            "type": "command"
          }
        ],
        "matcher": "Edit|Write"
      },
      {
        "matcher": ".*[Ww]ait.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.agents/skills/implementation-orchestrator/scripts/runtime_attestation.py\" --wait-hook",
            "statusMessage": "Attesting completed subagents"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bash \"$HOME/.codex/herdr-agent-state.sh\" session",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "tldraw-offline",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$HOME/skills/tldraw-offline/inject-server-context.sh\" SubagentStart"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "^implementation_orchestrator_.*$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.agents/skills/implementation-orchestrator/scripts/runtime_attestation.py\" --hook",
            "statusMessage": "Attesting subagent runtime"
          }
        ]
      }
    ]
  }
}
