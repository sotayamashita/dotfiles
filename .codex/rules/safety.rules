# Block high-risk commands outside the sandbox, even when explicitly requested.
#
# Rules match command prefixes. Include match and not_match examples with each
# rule; Codex validates them on load and with `codex execpolicy check`.
#
# hooks/git-safety.sh rejects literal --no-gpg-sign and force-push command text.
# It does not inspect shell expansions or commands inside external scripts.

prefix_rule(
    pattern = ["rm", ["-rf", "-fr", "-r"]],
    decision = "forbidden",
    justification = "Use `trash` or a targeted reversible operation instead of recursive removal.",
    match = [
        "rm -rf tmp",
        "rm -fr tmp",
        "rm -r tmp",
    ],
    not_match = [
        "trash tmp",
        "rm file.txt",
    ],
)

prefix_rule(
    pattern = ["sudo"],
    decision = "forbidden",
    justification = "Do not run privileged commands from Codex.",
    match = [
        "sudo make install",
    ],
    not_match = [
        "make install",
    ],
)

prefix_rule(
    pattern = ["chmod", "777"],
    decision = "forbidden",
    justification = "Do not make files world-writable.",
    match = [
        "chmod 777 script.sh",
    ],
    not_match = [
        "chmod 755 script.sh",
    ],
)

prefix_rule(
    pattern = ["git", "commit", "--no-gpg-sign"],
    decision = "forbidden",
    justification = "Disabling commit signing with `--no-gpg-sign` is always forbidden.",
    match = [
        "git commit --no-gpg-sign",
        "git commit --no-gpg-sign -m update",
    ],
    not_match = [
        "git commit -m update",
        "git commit -S -m update",
        "git commit -m --no-gpg-sign",
        "git commit -- --no-gpg-sign",
    ],
)

prefix_rule(
    pattern = ["git", "reset", "--hard"],
    decision = "forbidden",
    justification = "Hard resets are always forbidden because they can destroy user work.",
    match = [
        "git reset --hard",
        "git reset --hard HEAD~1",
    ],
    not_match = [
        "git reset --soft HEAD~1",
    ],
)

prefix_rule(
    pattern = ["git", "checkout", "--"],
    decision = "forbidden",
    justification = "Discarding uncommitted changes with `git checkout -- <path>` is always forbidden.",
    match = [
        "git checkout -- file.txt",
        "git checkout -- .",
    ],
    not_match = [
        "git checkout main",
        "git checkout -b feature",
    ],
)

prefix_rule(
    pattern = ["git", "clean", ["-f", "-fd", "-df", "-fdx", "-xfd", "-ffd"]],
    decision = "forbidden",
    justification = "Deleting untracked files with `git clean -f` is always forbidden.",
    match = [
        "git clean -f",
        "git clean -fd",
    ],
    not_match = [
        "git clean -n",
    ],
)

prefix_rule(
    pattern = ["git", "push", ["--force", "--force-with-lease", "-f"]],
    decision = "forbidden",
    justification = "Force-push is always forbidden.",
    match = [
        "git push --force",
        "git push --force-with-lease",
        "git push -f",
    ],
    not_match = ["git push"],
)

prefix_rule(
    pattern = ["git", "push", "origin", ["--force", "--force-with-lease", "-f"]],
    decision = "forbidden",
    justification = "Force-push is always forbidden.",
    match = [
        "git push origin --force",
        "git push origin --force-with-lease",
        "git push origin -f",
    ],
    not_match = ["git push origin main"],
)

prefix_rule(
    pattern = ["dd"],
    decision = "forbidden",
    justification = "`dd` is always forbidden because it can overwrite disks or files.",
    match = [
        "dd if=/dev/zero of=disk.img",
    ],
    not_match = [
        "diskutil list",
    ],
)

prefix_rule(
    pattern = ["mkfs"],
    decision = "forbidden",
    justification = "Filesystem formatting is destructive and must not be run by Codex.",
    match = [
        "mkfs /dev/disk2",
    ],
    not_match = [
        "mount",
    ],
)
